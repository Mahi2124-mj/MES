# 2026-05-29 - MES + CMS separated as services but video lookup re-enabled
# per operator request ("saari machine ki dot pe video nhi aa rhi").
# Collector still has zero coupling to CMS — only the MES API video
# endpoints (routers/lines.py + routers/submachines.py) call CMS for
# clip extraction.  CMS runs independently on port 5555.
# To DISABLE again: set both to 'disabled'.
CYCLE_VIDEO_BASE_URL=http://127.0.0.1:5555
CMS_BASE_URL=http://127.0.0.1:5555

# 2026-08-13 — operator: clips must play the FULL cycle, not a 2-min tail.
# 0 = no cap (bounded only by the ~50 min the rolling .ts actually holds).
# Read by routers/clip_archive.py, routers/submachines.py and routers/lines.py;
# all three clamp ONLY when this value is > 0, so 0 cleanly removes the cap from
# every render path (archive + on-demand) at once, with no code change.
CLIP_MAX_SECONDS=0

# 2026-08-13 — remote-desktop mouse/screen lag: the clip archiver's NVENC lane
# shares the single A2000 video engine with the remote-desktop screen.  Balanced
# setting: 2 (down from the default 4) halves the archiver's GPU encode load so
# the screen stays responsive, while still keeping half on the GPU so the CPU
# lane isn't asked to do everything.  0 = fully off GPU (smoothest screen, most
# CPU); 4 = original (busiest GPU).  MIN_IDLE_CORES still auto-pauses the whole
# archiver if CPU idle ever drops below 8 cores, so the CPU can't be starved.
CLIP_ARCHIVE_GPU_PARALLEL=2

# 2026-08-19 — system "bich bich me slow" fix.  With the GPU lane at 2 + full-
# length clips (CLIP_MAX_SECONDS=0), nearly every render spills to the libx264
# CPU lane, and each un-thread-capped ffmpeg grabbed up to ~15 cores; ~17 running
# at once pushed this 64-core box to load ~55 with interactive-lag spikes.
# Fix keeps BOTH full videos AND the smooth screen (GPU stays 2); it only makes
# the archiver leave more CPU free:
#   • MIN_IDLE_CORES 8 -> 16 : archiver always keeps 16 cores free for the
#     desktop / collectors / API (adaptive throttle — pauses when cores scarce).
#   • PARALLEL 10 -> 8       : fewer simultaneous heavy renders (smaller bursts).
# Only side effect: the archive backlog drains a little slower under peak load,
# and self-heals when the line is idle/off-shift (clips live ~50 min in the .ts).
CLIP_ARCHIVE_MIN_IDLE_CORES=16
CLIP_ARCHIVE_PARALLEL=8

