# EOL energydb daily backup -> 22TB disk (eol-data/database/)
# Runs 07:00 daily.  Change the time here + reinstall with:  crontab db_backup.cron
0 7 * * * "/run/media/server/5b4e6f01-4c04-4bc3-b34e-b0df376c067f/server backup/D DRIVE/EOL/EOL/Deep (2)/Deep/db_backup.sh" >> "/run/media/server/5b4e6f01-4c04-4bc3-b34e-b0df376c067f/server backup/D DRIVE/EOL/EOL/Deep (2)/Deep/logs/db_backup_cron.log" 2>&1
